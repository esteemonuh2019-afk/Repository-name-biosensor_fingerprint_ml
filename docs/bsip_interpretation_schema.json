{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsip.local/schema/bsip_interpretation_v2_1_0.json",
  "title": "BSIP 2.1.0 Scientific Interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interpretation_id",
    "category",
    "title",
    "claim",
    "status",
    "confidence",
    "supporting_observation_ids",
    "contradicting_observation_ids",
    "assumptions",
    "limitations",
    "evidence_summary",
    "reasoning_rule_ids",
    "created_at",
    "software_version",
    "source_observation_schema_version",
    "tags",
    "metadata"
  ],
  "properties": {
    "interpretation_id": {
      "type": "string",
      "pattern": "^INT-[A-Z_]+-[0-9]{4}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "DATASET_SCOPE",
        "DATA_QUALITY",
        "FINGERPRINT_STRUCTURE",
        "EXPLORATORY_STRUCTURE",
        "CHEMICAL_CLASSIFICATION",
        "CONCENTRATION_REGRESSION",
        "FEATURE_ENGINEERING",
        "FEATURE_SELECTION",
        "STRAIN_CONTRIBUTION",
        "BLIND_VALIDATION",
        "OVERALL_EVIDENCE"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIALLY_SUPPORTED",
        "CONFLICTED",
        "INSUFFICIENT_EVIDENCE",
        "NOT_ASSESSABLE"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "HIGH",
        "MODERATE",
        "LOW",
        "NOT_ASSESSABLE"
      ]
    },
    "supporting_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OBS-[A-Z_]+-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "contradicting_observation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OBS-[A-Z_]+-[0-9]{4}$"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_summary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interpretation_evidence_link"
      }
    },
    "reasoning_rule_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "software_version": {
      "type": "string",
      "minLength": 1
    },
    "source_observation_schema_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "interpretation_evidence_link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "direction",
        "rationale",
        "metric_names",
        "provenance_ids",
        "source_files"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^OBS-[A-Z_]+-[0-9]{4}$"
        },
        "direction": {
          "type": "string",
          "enum": [
            "SUPPORTING",
            "CONTRADICTING",
            "CONTEXTUAL"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "metric_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "provenance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
